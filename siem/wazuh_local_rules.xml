<!-- Regras locais do Wazuh (copiar para /var/ossec/etc/rules/local_rules.xml). NAO TESTADO aqui:
     o laboratorio usou siem/detect.py com a mesma logica. Os logs sao JSON, o decoder "json" ja extrai os campos. -->
<group name="vila_aurora,">

  <rule id="100100" level="10">
    <decoded_as>json</decoded_as>
    <field name="source">^vpn$</field>
    <field name="event">^auth_success$</field>
    <field name="mfa">^none$</field>
    <description>VA-A: login VPN sem MFA</description>
    <mitre><id>T1133</id></mitre>
  </rule>

  <rule id="100110" level="12">
    <decoded_as>json</decoded_as>
    <field name="source">^web$</field>
    <field name="query" type="pcre2">(?i)(union(\s|\+|%20)+select|%27|--|;|sqlite_master|information_schema|sleep\s*\()</field>
    <description>VA-B: padrao de SQL Injection no painel</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <rule id="100120" level="10">
    <decoded_as>json</decoded_as>
    <field name="source">^mqtt$</field>
    <field name="event">^tls_handshake$</field>
    <field name="result">^fail$</field>
    <description>VA-C: dispositivo sem certificado valido tentou conectar</description>
    <mitre><id>T1078</id></mitre>
  </rule>

  <rule id="100130" level="12">
    <decoded_as>json</decoded_as>
    <field name="source">^actuator$</field>
    <field name="cmd">^schedule$</field>
    <field name="via" negate="yes">^(painel|regra_local)$</field>
    <description>VA-D: comando de atuador com origem fora do perfil</description>
    <mitre><id>T0836</id></mitre>
  </rule>

  <!-- Resposta ativa (baixo risco): bloquear IP por 10 min. Acoes de alto impacto NAO entram aqui. -->
</group>
